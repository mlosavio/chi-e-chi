# Copiare in `.env` e riempire. `.env` è ignorato da git.

# Il rilevatore di dati personali, in locale.
# https://github.com/Rizzo-AI-Academy/rizzo-pii — gira su CPU, in un container.
# Vuoto o spento: il programma parte e non estrae niente, dicendolo.
PII_URL=http://127.0.0.1:5005

# Il modello. **Facoltativo**: senza chiave restano i campi che il rilevatore attribuisce
# da solo — il codice fiscale validato, e il nome e la data che se ne calcolano.
ANTHROPIC_API_KEY=

# Un modello che capisce il testo, non uno che lo scorre: attribuire un segnaposto al campo
# giusto richiede di capire che una via è la residenza del dipendente e l'altra la sede
# della società. Provato con uno più piccolo: più veloce, e tre esiti diversi su tre prove.
LLM_MODEL=claude-sonnet-5
